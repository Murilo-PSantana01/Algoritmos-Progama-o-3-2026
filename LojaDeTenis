import java.util.Scanner;
import java.math.BigDecimal;
import java.math.RoundingMode;

public class LojaDeTenis {

    
    public static int lerInteiro(Scanner entrada, String mensagem) {

        while (true) {
            System.out.print(mensagem);
            String valor = entrada.nextLine();

            try {
                return Integer.parseInt(valor);
            } catch (NumberFormatException e) {
                System.out.println("ERRO: Digite apenas numeros inteiros!");
            }
        }
    }

    
    public static String lerTexto(Scanner entrada, String mensagem) {

        while (true) {
            System.out.print(mensagem);
            String texto = entrada.nextLine().trim();

            if (!texto.isEmpty()) {
                return texto;
            }

            System.out.println("ERRO: Este campo nao pode ficar vazio!");
        }
    }

    public static void main(String[] args) {

        Scanner entrada = new Scanner(System.in);

        // Produtos
        String[] modelos = {
            "Nike Air Max 90",
            "Adidas Ultraboost"
        };

        BigDecimal[] precosBase = {
            new BigDecimal("599.90"),
            new BigDecimal("799.90")
        };

        int[] quantidades = {2, 5};

        
        String nomeCliente = "";
        String cpfCliente = "";
        boolean clienteCadastrado = false;

        // Dados financeiros
        BigDecimal faturamentoTotal = BigDecimal.ZERO;
        BigDecimal aliquotaTotal = new BigDecimal("27.25");

        int totalVendas = 0;
        int opcao;

        
        do {

            System.out.println("\n=== LOJA DE TENIS ===");
            System.out.println("1 - CADASTRAR CLIENTE");
            System.out.println("2 - COMPRAR TENIS (AREA DO CLIENTE)");
            System.out.println("3 - RELATORIO DE VENDAS (AREA DO VENDEDOR)");
            System.out.println("0 - SAIR");

            opcao = lerInteiro(entrada, "ESCOLHA UMA OPCAO: ");

            switch (opcao) {

                
                case 1:

                    System.out.println("\n--- CADASTRO DE CLIENTE ---");

                    nomeCliente = lerTexto(
                        entrada, "NOME COMPLETO: "
                    );

                    
                    while (true) {

                        cpfCliente = lerTexto(entrada, "CPF: ");

                        String cpfNumeros = cpfCliente.replaceAll("\\D", "");

                        if (cpfNumeros.length() == 11) {
                            cpfCliente = cpfNumeros;
                            break;
                        }

                        System.out.println(
                            "ERRO: O CPF deve possuir 11 digitos!"
                        );
                    }

                    clienteCadastrado = true;

                    System.out.println(
                        "CLIENTE CADASTRADO COM SUCESSO!"
                    );

                    break;

                
                case 2:

                    if (!clienteCadastrado) {

                        System.out.println(
                            "[AVISO] FACA O CADASTRO ANTES DE COMPRAR!"
                        );

                        break;
                    }

                    System.out.println("\n--- CATALOGO DE PRODUTOS ---");

                    
                    for (int i = 0; i < modelos.length; i++) {

                        BigDecimal precoComImposto = precosBase[i]
                            .multiply(
                                BigDecimal.ONE.add(
                                    aliquotaTotal.divide(
                                        new BigDecimal("100")
                                    )
                                )
                            )
                            .setScale(2, RoundingMode.HALF_UP);

                        System.out.printf(
                            "%d - %s | PRECO C/ IMPOSTOS: R$ %s | ESTOQUE: %d%n",
                            i + 1,
                            modelos[i],
                            precoComImposto.toPlainString(),
                            quantidades[i]
                        );
                    }

                    int escolha = lerInteiro(
                        entrada,
                        "DIGITE O NUMERO DO PRODUTO DESEJADO: "
                    );

                    int indice = escolha - 1;

                    
                    if (indice < 0 || indice >= modelos.length) {

                        System.out.println(
                            "OPCAO DE PRODUTO INVALIDA!"
                        );

                        break;
                    }

                    
                    if (quantidades[indice] <= 0) {

                        System.out.println(
                            "DESCULPE, PRODUTO ESGOTADO!"
                        );

                        break;
                    }

                    
                    BigDecimal precoFinal = precosBase[indice]
                        .multiply(
                            BigDecimal.ONE.add(
                                aliquotaTotal.divide(
                                    new BigDecimal("100")
                                )
                            )
                        )
                        .setScale(2, RoundingMode.HALF_UP);

                    
                    quantidades[indice]--;
                    totalVendas++;

                    faturamentoTotal = faturamentoTotal.add(precoFinal);

                    
                    System.out.println("\nCOMPRA REALIZADA COM SUCESSO!");

                    System.out.println("CLIENTE: " + nomeCliente);
                    System.out.println("CPF: " + cpfCliente);
                    System.out.println("PRODUTO: " + modelos[indice]);

                    System.out.printf(
                        "VALOR DA COMPRA: R$ %s%n",
                        precoFinal.toPlainString()
                    );

                    System.out.println(
                        "ESTOQUE RESTANTE: " + quantidades[indice]
                    );

                    break;

                
                case 3:

                    System.out.println(
                        "\n--- RELATORIO DO VENDEDOR ---"
                    );

                    System.out.println(
                        "TOTAL DE ITENS VENDIDOS: " + totalVendas
                    );

                    System.out.printf(
                        "FATURAMENTO ACUMULADO: R$ %s%n",
                        faturamentoTotal.toPlainString()
                    );

                    System.out.println("\n--- ESTOQUE ATUAL ---");

                    for (int i = 0; i < modelos.length; i++) {

                        System.out.println(
                            modelos[i] + ": " + quantidades[i] + " unidades"
                        );
                    }

                    break;

                
                case 0:

                    System.out.println(
                        "\nSISTEMA FINALIZADO."
                    );

                    break;

                default:

                    System.out.println(
                        "OPCAO INVALIDA! ESCOLHA ENTRE 0 E 3."
                    );

                    break;
            }

        } while (opcao != 0);

        entrada.close();
    }
}